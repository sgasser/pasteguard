{
  "name": "pasteguard",
  "version": "0.9.11",
  "description": "Privacy proxy for LLMs. Masks personal data and secrets before sending to your provider.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun --external lightningcss",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "typecheck:benchmarks": "tsc --noEmit --project tsconfig.benchmarks.json",
    "lint": "biome lint src benchmarks/pii-accuracy/*.ts",
    "format": "biome format src benchmarks/pii-accuracy/*.ts --write",
    "check": "biome check src benchmarks/pii-accuracy/*.ts",
    "benchmark:accuracy": "bun run benchmarks/pii-accuracy/run.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@tailwindcss/postcss": "^4.3.5",
    "hono": "^4.12.25",
    "hono-tailwind": "^3.0.1",
    "kysely": "^0.29.9",
    "pg": "^8.23.1",
    "tailwindcss": "^4.3.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/bun": "latest",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "postcss": "8.5.32"
  },
  "keywords": [
    "llm",
    "privacy",
    "pii",
    "openai",
    "proxy",
    "gdpr",
    "routing"
  ],
  "author": "Stefan Gasser",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sgasser/pasteguard"
  }
}
